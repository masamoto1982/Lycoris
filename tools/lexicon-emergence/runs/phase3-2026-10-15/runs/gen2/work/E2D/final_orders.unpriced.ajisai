[ 0 [ ADD ] FOLD ] 'E2D.SUM' DEF
[ 'C' BIND 'S' BIND S -1 GET C 2 COLLECT JOIN 'P' BIND S -1 DROP S C 1 COLLECT CONCAT 2 COLLECT 0 1 P '()' EQ NOT P '[]' EQ NOT AND NOT SELECT GET ] 'E2D.BRSTEP' DEF
[ CHARS [ '' ] [ E2D.BRSTEP ] FOLD LENGTH 1 SUB ] 'E2D.UNMATCHED' DEF
[ CHARS [ '' ] [ E2D.BRSTEP ] SCAN [ LENGTH 1 SUB ] MAP ] 'E2D.BRSIZES' DEF
[ [ NIL? NOT ] FILTER ] 'E2D.PRESENT' DEF
[ [ NIL? ] MAP 'T' BIND 1 0 T SELECT G0D.RUNS [ 0 GET 1 EQ ] FILTER ] 'E2D.GAPS' DEF
[ G0C.ORDERS 'O' BIND O [ 'sku' GET ] MAP O [ 'qty' GET ] MAP GROUP 'G' BIND G KEYS G VALUES [ E2D.SUM ] MAP RECORD ] 'E2D.QTYBYSKU' DEF
[ G0C.ORDERS [ 'price' HAS? ] FILTER [ 'O' BIND O 'qty' GET O 'price' GET MUL ] MAP E2D.SUM ] 'E2D.REVENUE' DEF
[ 'N' BIND 0 199 RANGE N 0 2 COLLECT [ 'I' BIND [ 'C' 'K' ] BIND C 2 DIV 'H' BIND H FLOOR H EQ 'E' BIND H 3 C MUL 1 ADD E SELECT 'NX' BIND C K 2 COLLECT NX K 1 ADD 2 COLLECT C 1 EQ SELECT ] FOLD 1 GET ] 'E2D.COLLATZ' DEF
[ 0 11 RANGE 0 1 2 COLLECT [ 'I' BIND [ 'A' 'B' ] BIND B A B ADD 2 COLLECT ] SCAN [ 0 GET ] MAP ] 'E2D.FIBS' DEF
[ 'N' BIND 9 0 RANGE [ 'K' BIND N 2 K POW DIV FLOOR 'Q' BIND Q Q 2 DIV FLOOR 2 MUL SUB ] MAP 'B' BIND B B U1D.ARGMAX DROP STR JOIN ] 'E2D.BINARY' DEF
[ 'V' BIND 1 0 V V G0D.SHIFT GT SELECT 0 [ 'X' BIND 'A' BIND 0 A 1 ADD X 0 EQ SELECT ] SCAN 0 [ MAX ] FOLD 1 ADD ] 'E2D.UPRUNS' DEF
[ CHARS 'C' BIND C 0 GET UPPER 1 COLLECT C 1 DROP CONCAT JOIN ] 'E2D.CAPWORD' DEF
'{"orders":[{"sku":"a1","qty":2,"price":1.5},{"sku":"b2","qty":1,"price":4,"tags":["gift"]},{"sku":"a1","qty":3,"price":1.5,"tags":["bulk","gift"]},{"sku":"c3","qty":5}]}' G0C.ORDERS [ 'price' HAS? NOT ] FILTER [ 'sku' GET ] MAP UNIQUE
