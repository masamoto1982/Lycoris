[ 0 [ ADD ] FOLD ] 'E1A.SUM' DEF
[ [ NIL? NOT ] FILTER ] 'E1A.PRESENT' DEF
[ 'E1A.VM' BIND E1A.VM E1A.VM 0 GET [ MAX ] FOLD ] 'E1A.VMAX' DEF
[ -1 MUL ORDER 0 GET GET ] 'E1A.ARGMAX' DEF
[ 'E1A.SR' BIND E1A.SR KEYS E1A.SR VALUES [ E1A.SUM ] MAP RECORD ] 'E1A.SUMBY' DEF
[ G0B.REDUCE '' EQ ] 'E1A.ISBAL' DEF
'x'
LOWER G0D.WORDS UNIQUE SORT G0A.UNWORDS
