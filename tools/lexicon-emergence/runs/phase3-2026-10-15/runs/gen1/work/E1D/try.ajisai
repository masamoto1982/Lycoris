[ 0 [ ADD ] FOLD ] 'E1D.SUM' DEF
[ -1 MUL ORDER 0 GET ] 'E1D.ARGMAX' DEF
[ 'E1D.TR' BIND E1D.TR KEYS E1D.TR VALUES E1D.ARGMAX GET ] 'E1D.TOPKEY' DEF
[ G0D.RUNS [ 'E1D.R' BIND E1D.R 0 GET E1D.R LENGTH 2 COLLECT ] MAP ] 'E1D.RLE' DEF
[ 'E1D.V' BIND E1D.V E1D.V G0D.SHIFT SUB [ 'E1D.D' BIND 1 0 E1D.D 0 GT SELECT ] MAP ] 'E1D.UPFLAGS' DEF
[ 0 [ 'E1D.X' BIND 'E1D.A' BIND E1D.A 1 ADD E1D.X MUL ] SCAN ] 'E1D.STREAKS' DEF
[ 'E1D.V' BIND E1D.V TALLY 'E1D.T' BIND E1D.T KEYS E1D.T VALUES 2 COLLECT ZIP [ 1 GET E1D.V LENGTH 2 DIV GT ] FILTER [ 0 GET ] MAP 0 GET ] 'E1D.MAJORITY' DEF
[ 'E1D.N' BIND 1 E1D.N RANGE [ G0D.DIVISORS LENGTH 2 EQ ] FILTER ] 'E1D.PRIMES' DEF
[ 'E1D.N' BIND 5 0 RANGE [ 'E1D.K' BIND E1D.N 2 E1D.K POW DIV FLOOR 'E1D.Q' BIND E1D.Q E1D.Q 2 DIV FLOOR 2 MUL SUB ] MAP STR JOIN 'E1D.S' BIND E1D.S CHARS E1D.S '1' SEARCH DROP JOIN ] 'E1D.BINARY' DEF
[ [ 'E1D.C' 'E1D.S' ] BIND E1D.C 2 DIV FLOOR 'E1D.H' BIND E1D.C E1D.S 2 COLLECT E1D.H E1D.C 3 MUL 1 ADD E1D.C E1D.H 2 MUL SUB 0 EQ SELECT E1D.S 1 ADD 2 COLLECT E1D.C 1 EQ SELECT ] 'E1D.CSTEP' DEF
[ 'E1D.N' BIND 1 130 RANGE E1D.N 0 2 COLLECT [ 'E1D.I' BIND E1D.CSTEP ] FOLD 1 GET ] 'E1D.COLLATZ' DEF
[ 'E1D.M' BIND E1D.M E1D.M 9 DIV FLOOR 9 MUL SUB ] 'E1D.MOD9' DEF
[ CHARS [ 'E1D.C' BIND 1 -1 '([' E1D.C SEARCH NIL? NOT SELECT ] MAP ] 'E1D.BDELTA' DEF
[ CHARS '#' [ G0A.BSTEP ] SCAN ] 'E1D.BSTACKS' DEF
[ [ NIL? NOT ] FILTER ] 'E1D.PRESENT' DEF
[ [ 'E1D.X' BIND 1 0 E1D.X NIL? SELECT ] MAP ] 'E1D.MISSING' DEF
[ E1D.MISSING G0D.RUNS [ 0 GET 1 EQ ] FILTER ] 'E1D.GAPS' DEF
[ G0C.ORDERS [ 'price' GET NIL? NOT ] FILTER [ 'E1D.O' BIND E1D.O 'qty' GET E1D.O 'price' GET MUL ] MAP E1D.SUM ] 'E1D.REVENUE' DEF
[ G0C.ORDERS 'E1D.OS' BIND E1D.OS [ 'sku' GET ] MAP E1D.OS [ 'qty' GET ] MAP GROUP 'E1D.G' BIND E1D.G KEYS E1D.G VALUES [ E1D.SUM ] MAP RECORD ] 'E1D.QTY-BY-SKU' DEF
[ LOWER CHARS 'E1D.C' BIND E1D.C 0 GET UPPER E1D.C 1 DROP JOIN 2 COLLECT JOIN ] 'E1D.CAP' DEF
'  The cat saw THE dog   and the Cat  '
LOWER G0D.WORDS UNIQUE SORT G0A.UNWORDS
