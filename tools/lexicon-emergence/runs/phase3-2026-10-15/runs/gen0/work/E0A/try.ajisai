[ 'V' BIND [ 0 ] V -1 DROP V 1 DROP 2 COLLECT ZIP [ 'P' BIND 0 1 P 1 TAKE P -1 TAKE EQ SELECT ] MAP CONCAT 0 [ ADD ] SCAN V GROUP VALUES ] 'E0A.RUNS' DEF
[ 0 [ ADD ] FOLD ] 'E0A.SUM' DEF
[ 'V' BIND V V 0 GET [ MAX ] FOLD ] 'E0A.VMAX' DEF
[ -1 MUL ORDER 0 GET ] 'E0A.ARGMAX' DEF
[ 'B' BIND 'A' BIND A A B DIV FLOOR B MUL SUB ] 'E0A.MOD' DEF
[ 'N' BIND 1 N RANGE [ 'D' BIND N D E0A.MOD 0 EQ ] FILTER ] 'E0A.DIVISORS' DEF
[ [ NIL? NOT ] FILTER ] 'E0A.PRESENT' DEF
[ 'S' BIND 0 S CHARS LENGTH RANGE S [ 'I' BIND '()' '' REPLACE '[]' '' REPLACE ] FOLD ] 'E0A.REDUCE' DEF
[ E0A.REDUCE '' EQ ] 'E0A.BALANCED' DEF
[ ' ' TOKENIZE [ '' EQ NOT ] FILTER ] 'E0A.WORDS' DEF
[ [ ' ' 2 COLLECT JOIN ] MAP JOIN TRIM ] 'E0A.UNWORDS' DEF
[ JSON-DECODE 'orders' GET ] 'E0A.ORDERS' DEF
[ 'R' BIND R 'qty' GET R 'price' GET MUL 'X' BIND 0 X X NIL? SELECT ] 'E0A.LINE' DEF
[ E0A.ORDERS [ E0A.LINE ] MAP E0A.SUM ] 'E0A.REVENUE' DEF
[ E0A.ORDERS 'O' BIND O [ 'sku' GET ] MAP O [ 'qty' GET ] MAP GROUP 'G' BIND G KEYS G VALUES [ E0A.SUM ] MAP RECORD ] 'E0A.QTYBYSKU' DEF
'  x  '
LOWER E0A.WORDS UNIQUE SORT E0A.UNWORDS
