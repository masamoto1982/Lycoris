[ 'B' BIND 'A' BIND A A B DIV FLOOR B MUL SUB ] 'E0D.MOD' DEF
[ 'B' BIND 'A' BIND A NOT B NOT AND NOT ] 'E0D.OR' DEF
[ 'T' BIND 2 COLLECT 0 1 T SELECT GET ] 'E0D.PICK' DEF
[ 0 [ ADD ] FOLD ] 'E0D.SUM' DEF
[ 'P' BIND P E0D.SUM P LENGTH DIV ] 'E0D.MEAN' DEF
[ [ 'X' BIND 1 ] MAP 0 [ ADD ] SCAN 1 SUB ] 'E0D.IOTA' DEF
[ 2 COLLECT ZIP [ 1 GET ] FILTER [ 0 GET ] MAP ] 'E0D.MASK' DEF
[ 'V' BIND V -1 DROP V 1 DROP 2 COLLECT ZIP ] 'E0D.ADJ' DEF
[ E0D.ADJ [ 'P' BIND P 1 TAKE P 1 DROP EQ NOT ] MAP ] 'E0D.CHANGES' DEF
[ 'V' BIND V 1 TAKE V 1 DROP V E0D.CHANGES E0D.MASK CONCAT ] 'E0D.DEDUPE' DEF
[ 'V' BIND V E0D.CHANGES 'CH' BIND [ 0 ] CH E0D.IOTA 1 ADD CH E0D.MASK CONCAT 'S' BIND S 1 DROP V LENGTH 1 COLLECT CONCAT S SUB ] 'E0D.RUNLENS' DEF
[ 'V' BIND V E0D.DEDUPE V E0D.RUNLENS 2 COLLECT ZIP ] 'E0D.RLE' DEF
[ 0 [ 'T' BIND 'A' BIND A 1 ADD 0 T SELECT ] SCAN 0 [ MAX ] FOLD ] 'E0D.LONGEST-TRUE' DEF
[ [ 0 FALSE ] [ 'T' BIND [ 'C' 'P' ] BIND C 1 ADD C T P NOT AND SELECT T 2 COLLECT ] FOLD 0 GET ] 'E0D.TRUE-RUNS' DEF
[ 'R' BIND R VALUES 'C' BIND C C 0 GET [ MAX ] FOLD 'M' BIND R KEYS C [ M EQ ] MAP E0D.MASK 0 GET ] 'E0D.ARGMAX-KEY' DEF
[ 'N' BIND 1 N RANGE [ 'D' BIND N D E0D.MOD 0 EQ ] FILTER ] 'E0D.DIVISORS' DEF
[ E0D.DIVISORS LENGTH 2 EQ ] 'E0D.PRIME?' DEF
[ 'N' BIND 5 0 RANGE [ 'P' BIND N 2 P POW DIV FLOOR 2 E0D.MOD STR ] MAP JOIN 'S' BIND S CHARS S '1' SEARCH DROP JOIN ] 'E0D.BINARY' DEF
[ 'N' BIND 1 130 RANGE N 0 2 COLLECT [ 'X' BIND [ 'C' 'S' ] BIND C 1 EQ 'D' BIND C C 2 DIV C 3 MUL 1 ADD C 2 E0D.MOD 0 EQ SELECT D SELECT S S 1 ADD D SELECT 2 COLLECT ] FOLD 1 GET ] 'E0D.COLLATZ' DEF
[ 'N' BIND 1 12 RANGE [ 0 1 ] [ 'X' BIND [ 'A' 'B' ] BIND B A B ADD 2 COLLECT ] SCAN [ 0 GET ] MAP [ N LT ] FILTER LENGTH 1 ADD ] 'E0D.FIB-INDEX' DEF
[ 'C' BIND '([' C SEARCH NIL? NOT ] 'E0D.OPEN?' DEF
[ CHARS [ 'C' BIND 1 -1 C E0D.OPEN? SELECT ] MAP 0 [ ADD ] SCAN 0 [ MAX ] FOLD ] 'E0D.DEPTH' DEF
[ 'C' BIND [ 'S' 'OK' ] BIND C E0D.OPEN? 'OP' BIND '(' '[' C ')' EQ SELECT 'X' BIND S -1 GET X EQ 'M' BIND S C 1 COLLECT CONCAT S -1 DROP OP E0D.PICK S OP M E0D.OR E0D.PICK OK OP M E0D.OR AND 2 COLLECT ] 'E0D.BSTEP' DEF
[ [ 'S' 'OK' ] BIND OK S LENGTH 1 EQ AND ] 'E0D.BOK' DEF
[ CHARS [ [ '#' ] TRUE ] [ E0D.BSTEP ] FOLD E0D.BOK ] 'E0D.BALANCED' DEF
[ CHARS [ [ '#' ] TRUE ] [ E0D.BSTEP ] SCAN [ E0D.BOK ] MAP 'T' BIND T E0D.IOTA 1 ADD T E0D.MASK 0 [ MAX ] FOLD ] 'E0D.BALANCED-PREFIX' DEF
[ 'C' BIND 'S' BIND S -1 GET C 2 COLLECT JOIN 'PR' BIND S -1 DROP S C 1 COLLECT CONCAT PR '()' EQ PR '[]' EQ E0D.OR E0D.PICK ] 'E0D.USTEP' DEF
[ CHARS [ '#' ] [ E0D.USTEP ] FOLD LENGTH 1 SUB ] 'E0D.UNMATCHED' DEF
[ [ NIL? NOT ] FILTER ] 'E0D.PRESENT' DEF
[ 'V' BIND V V E0D.PRESENT 0 GET [ 'X' BIND 'A' BIND A X X NIL? SELECT ] SCAN ] 'E0D.FILLED' DEF
[ 'V' BIND V E0D.PRESENT 'P' BIND V P P 0 GET [ MAX ] FOLD DIV ] 'E0D.SCALED' DEF
[ JSON-DECODE 'orders' GET ] 'E0D.ORDERS' DEF
[ E0D.ORDERS [ 'O' BIND O 'qty' GET O 'price' GET MUL 0 O 'price' HAS? SELECT ] MAP E0D.SUM ] 'E0D.REVENUE' DEF
[ E0D.ORDERS 'O' BIND O [ 'sku' GET ] MAP O [ 'qty' GET ] MAP GROUP 'G' BIND G KEYS G VALUES [ E0D.SUM ] MAP RECORD ] 'E0D.QTY-BY-SKU' DEF
[ ' ' TOKENIZE [ '' EQ NOT ] FILTER ] 'E0D.WORDS' DEF
[ [ 'X' BIND ' ' X 2 COLLECT JOIN ] MAP JOIN TRIM ] 'E0D.UNWORDS' DEF
[ CHARS 'CS' BIND CS 1 TAKE JOIN UPPER CS 1 DROP JOIN LOWER 2 COLLECT JOIN ] 'E0D.CAPITALIZE' DEF
'  The cat saw THE dog   and the Cat  '
LOWER E0D.WORDS UNIQUE SORT E0D.UNWORDS
