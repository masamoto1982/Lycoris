  "definitions": [
    {
      "name": "S0A.PRESENT",
      "body": "[ NIL? NOT ] FILTER",
      "note": "Vector -> its elements that are not NIL, in order"
    },
    {
      "name": "S0A.SUM",
      "body": "0 [ ADD ] FOLD",
      "note": "Vector of numbers -> their sum (0 for empty)"
    },
    {
      "name": "S0A.MEAN",
      "body": "'V' BIND V S0A.SUM V LENGTH DIV",
      "note": "Vector of numbers -> their arithmetic mean"
    },
    {
      "name": "S0A.MAXOF",
      "body": "'V' BIND V V 0 GET [ MAX ] FOLD",
      "note": "Non-empty Vector of numbers -> its largest element"
    },
    {
      "name": "S0A.FFILL",
      "body": "'V' BIND V V S0A.PRESENT 0 GET [ 'E' BIND 'A' BIND A E E NIL? SELECT ] SCAN",
      "note": "Vector with NILs -> each NIL replaced by the last present value before it (leading NILs take the first present value)"
    },
    {
      "name": "S0A.NILMASK",
      "body": "[ NIL? ] MAP",
      "note": "Vector -> Vector of booleans, TRUE where the element is NIL"
    },
    {
      "name": "S0A.COUNT-TRUE",
      "body": "[ ] FILTER LENGTH",
      "note": "Vector of booleans -> how many are TRUE"
    },
    {
      "name": "S0A.NIL-RUNS",
      "body": "S0A.NILMASK 'M' BIND M [ FALSE ] M -1 DROP CONCAT NOT AND S0A.COUNT-TRUE",
      "note": "Vector -> number of runs of consecutive NIL elements"
    },
    {
      "name": "S0A.NIL-RUN-LENGTHS",
      "body": "0 [ 'E' BIND 1 ADD 0 E NIL? SELECT ] SCAN",
      "note": "Vector -> for each position, length of the NIL run ending there (0 where present)"
    },
    {
      "name": "S0A.LONGEST-NIL-RUN",
      "body": "S0A.NIL-RUN-LENGTHS 0 [ MAX ] FOLD",
      "note": "Vector -> length of the longest run of consecutive NILs (0 if none)"
    },
    {
      "name": "S0A.PAIR-RATIOS",
      "body": "'V' BIND V 1 DROP V -1 DROP DIV",
      "note": "Vector -> each element divided by the one before it (NIL where either is NIL), one shorter"
    },
    {
      "name": "S0A.SCALE-TO-MAX",
      "body": "'V' BIND V V S0A.PRESENT S0A.MAXOF DIV",
      "note": "Vector with NILs -> each present value divided by the largest present value, NILs kept"
    },
    {
      "name": "S0A.ARGMAX-KEY",
      "body": "'R' BIND R KEYS R VALUES -1 MUL ORDER 0 GET GET",
      "note": "Record of numbers -> the key with the largest value, first key wins ties"
    },
    {
      "name": "S0A.ORDERS",
      "body": "JSON-DECODE 'orders' GET",
      "note": "JSON text -> the Vector of Records under its \"orders\" key"
    },
    {
      "name": "S0A.FIELD",
      "body": "'K' BIND [ K GET ] MAP",
      "note": "Vector of Records, key -> Vector of each Record's value at key (NIL when missing)"
    },
    {
      "name": "S0A.SUM-BY",
      "body": "GROUP 'G' BIND G KEYS G VALUES [ S0A.SUM ] MAP RECORD",
      "note": "keys Vector, numbers Vector -> Record from each distinct key to the sum of its numbers, first-appearance order"
    },
    {
      "name": "S0A.ORDER-REVENUE",
      "body": "S0A.ORDERS 'O' BIND O 'qty' S0A.FIELD O 'price' S0A.FIELD MUL S0A.PRESENT S0A.SUM",
