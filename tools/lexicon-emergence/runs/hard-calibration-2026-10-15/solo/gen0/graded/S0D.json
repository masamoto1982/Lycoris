    {
      "name": "S0D.SUM",
      "body": "0 [ ADD ] FOLD",
      "note": "Sum of a Vector of numbers (0 for an empty one)."
    },
    {
      "name": "S0D.PRESENT",
      "body": "[ NIL? NOT ] FILTER",
      "note": "The non-NIL elements of a Vector, in order."
    },
    {
      "name": "S0D.MEAN",
      "body": "'P' BIND P S0D.SUM P LENGTH DIV",
      "note": "Mean of a non-empty Vector of numbers."
    },
    {
      "name": "S0D.FFILL",
      "body": "'V' BIND V V S0D.PRESENT 0 GET [ 'X' BIND 'A' BIND A X X NIL? SELECT ] SCAN",
      "note": "Forward-fill: each NIL takes the nearest present element before it; leading NILs take the first present element."
    },
    {
      "name": "S0D.GAP-STARTS",
      "body": "[ NIL? ] MAP 'M' BIND M [ FALSE ] M -1 DROP CONCAT NOT AND",
      "note": "Truth Vector marking each position that begins a run of NILs."
    },
    {
      "name": "S0D.COUNT-TRUE",
      "body": "'T' BIND 1 0 T SELECT S0D.SUM",
      "note": "How many lanes of a truth Vector are TRUE."
    },
    {
      "name": "S0D.LONGEST-GAP",
      "body": "0 [ 'X' BIND 'A' BIND A 1 ADD 0 X NIL? SELECT ] SCAN 0 [ MAX ] FOLD",
      "note": "Length of the longest run of consecutive NILs in a Vector (0 if none)."
    },
    {
      "name": "S0D.RATIOS",
      "body": "'V' BIND V 1 DROP V -1 DROP DIV",
      "note": "Each element divided by the one before it (one shorter than the input); NIL where either is NIL."
    },
    {
      "name": "S0D.SCALED",
      "body": "'V' BIND V V S0D.PRESENT 'P' BIND P P 0 GET [ MAX ] FOLD DIV",
      "note": "Each element divided by the largest present element; NILs stay NIL."
    },
    {
      "name": "S0D.ORDERS",
      "body": "JSON-DECODE 'orders' GET",
      "note": "Decode a JSON text and take its 'orders' array (a Vector of Records)."
    },
    {
      "name": "S0D.REVENUE",
      "body": "[ 'price' HAS? ] FILTER [ 'R' BIND R 'qty' GET R 'price' GET MUL ] MAP S0D.SUM",
      "note": "Sum of qty times price over the order Records that hold a 'price' key."
    },
    {
      "name": "S0D.QTY-BY-SKU",
      "body": "'O' BIND O [ 'sku' GET ] MAP O [ 'qty' GET ] MAP GROUP 'G' BIND G KEYS G VALUES [ S0D.SUM ] MAP RECORD",
      "note": "Record from each 'sku' to the sum of its 'qty' over a Vector of order Records, keys in order of first appearance."
