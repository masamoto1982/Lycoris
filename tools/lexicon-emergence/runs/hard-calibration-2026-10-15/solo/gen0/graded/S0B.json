      "body": "JSON-DECODE 'orders' GET",
      "note": "JSON String -> Vector of order Records."
    },
    {
      "name": "S0B.COL",
      "body": "'F' BIND [ F GET ] MAP",
      "note": "Vector of Records, key -> Vector of that key's values (NIL where missing)."
    },
    {
      "name": "S0B.REVENUE",
      "body": "S0B.ORDERS 'O' BIND O 'qty' S0B.COL O 'price' S0B.COL MUL S0B.PRESENT S0B.SUM",
