      "note": "Record sku -> summed qty, from JSON String."
    },
    {
      "name": "S0B.WORDS",
      "body": "LOWER ' ' TOKENIZE [ '' EQ NOT ] FILTER",
      "note": "String -> Vector of lowercased words, ignoring extra spaces."
    },
    {
