[ [ NIL? NOT ] FILTER ] 'S0B.PRESENT' DEF
[ 0 [ ADD ] FOLD ] 'S0B.SUM' DEF
[ [ NIL? ] MAP 0 [ 'E' BIND 'A' BIND A 1 ADD 0 E SELECT ] SCAN ] 'S0B.GAPRUNS' DEF
[ JSON-DECODE 'orders' GET ] 'S0B.ORDERS' DEF
[ 'F' BIND [ F GET ] MAP ] 'S0B.COL' DEF
[ S0B.ORDERS 'O' BIND O 'qty' S0B.COL O 'price' S0B.COL MUL S0B.PRESENT S0B.SUM ] 'S0B.REVENUE' DEF
[ S0B.ORDERS 'O' BIND O 'sku' S0B.COL O 'qty' S0B.COL GROUP 'G' BIND G KEYS G VALUES [ S0B.SUM ] MAP RECORD ] 'S0B.QTYREC' DEF
[ LOWER ' ' TOKENIZE [ '' EQ NOT ] FILTER ] 'S0B.WORDS' DEF
[ [ 'W' BIND W ' ' 2 COLLECT JOIN ] MAP JOIN TRIM ] 'S0B.JOINSP' DEF
[ 'W' BIND W CHARS 'C' BIND C 0 GET UPPER C 1 DROP JOIN 2 COLLECT JOIN ] 'S0B.CAP' DEF
[ 'R' BIND R KEYS R VALUES -1 MUL ORDER 0 GET GET ] 'S0B.TOPKEY' DEF
[ NIL NIL 7 ]
'V' BIND V S0B.PRESENT 'P' BIND P S0B.SUM P LENGTH DIV
