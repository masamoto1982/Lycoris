[ 0 [ ADD ] FOLD ] 'S0C.SUM' DEF
[ JSON-DECODE 'orders' GET ] 'S0C.ORDERS' DEF
[ [ 'Q' BIND 0 Q 'qty' GET Q 'price' GET MUL Q 'price' GET NIL? SELECT ] MAP 0 [ ADD ] FOLD ] 'S0C.REVENUE' DEF
[ 'O' BIND O [ 'sku' GET ] MAP O [ 'qty' GET ] MAP GROUP 'G' BIND G KEYS G VALUES [ S0C.SUM ] MAP RECORD ] 'S0C.QTY_BY_SKU' DEF
[ 'R' BIND R KEYS R VALUES -1 MUL ORDER 0 GET GET ] 'S0C.ARGMAX_FIRST' DEF
[ ' ' TOKENIZE [ 'Q' BIND Q '' EQ NOT ] FILTER ] 'S0C.WORDS' DEF
[ 'W' BIND W CHARS 1 TAKE JOIN UPPER W CHARS 1 DROP JOIN LOWER 2 COLLECT JOIN ] 'S0C.CAPWORD' DEF
