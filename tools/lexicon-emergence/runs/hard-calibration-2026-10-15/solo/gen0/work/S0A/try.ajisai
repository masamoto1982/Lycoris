[ [ NIL? NOT ] FILTER ] 'S0A.PRESENT' DEF
[ 0 [ ADD ] FOLD ] 'S0A.SUM' DEF
[ 'V' BIND V S0A.SUM V LENGTH DIV ] 'S0A.MEAN' DEF
[ 'V' BIND V V 0 GET [ MAX ] FOLD ] 'S0A.MAXOF' DEF
[ 'V' BIND V V S0A.PRESENT 0 GET [ 'E' BIND 'A' BIND A E E NIL? SELECT ] SCAN ] 'S0A.FFILL' DEF
[ [ NIL? ] MAP ] 'S0A.NILMASK' DEF
[ [ ] FILTER LENGTH ] 'S0A.COUNT-TRUE' DEF
[ S0A.NILMASK 'M' BIND M [ FALSE ] M -1 DROP CONCAT NOT AND S0A.COUNT-TRUE ] 'S0A.NIL-RUNS' DEF
[ 0 [ 'E' BIND 1 ADD 0 E NIL? SELECT ] SCAN ] 'S0A.NIL-RUN-LENGTHS' DEF
[ S0A.NIL-RUN-LENGTHS 0 [ MAX ] FOLD ] 'S0A.LONGEST-NIL-RUN' DEF
[ 'V' BIND V 1 DROP V -1 DROP DIV ] 'S0A.PAIR-RATIOS' DEF
[ 'V' BIND V V S0A.PRESENT S0A.MAXOF DIV ] 'S0A.SCALE-TO-MAX' DEF
[ 'R' BIND R KEYS R VALUES -1 MUL ORDER 0 GET GET ] 'S0A.ARGMAX-KEY' DEF
[ JSON-DECODE 'orders' GET ] 'S0A.ORDERS' DEF
[ 'K' BIND [ K GET ] MAP ] 'S0A.FIELD' DEF
[ GROUP 'G' BIND G KEYS G VALUES [ S0A.SUM ] MAP RECORD ] 'S0A.SUM-BY' DEF
[ S0A.ORDERS 'O' BIND O 'qty' S0A.FIELD O 'price' S0A.FIELD MUL S0A.PRESENT S0A.SUM ] 'S0A.ORDER-REVENUE' DEF
[ S0A.ORDERS 'O' BIND O 'sku' S0A.FIELD O 'qty' S0A.FIELD S0A.SUM-BY ] 'S0A.QTY-BY-SKU' DEF
[ [ ] [ CONCAT ] FOLD ] 'S0A.FLAT1' DEF
[ ' ' TOKENIZE [ '' EQ NOT ] FILTER ] 'S0A.WORDS' DEF
[ [ ' ' 2 COLLECT JOIN ] MAP JOIN TRIM ] 'S0A.UNWORDS' DEF
[ CHARS 'C' BIND C 0 GET UPPER C 1 DROP JOIN LOWER 2 COLLECT JOIN ] 'S0A.CAPITALIZE' DEF
'b a  B A c'
LOWER S0A.WORDS UNIQUE SORT S0A.UNWORDS
