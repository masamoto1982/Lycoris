  "definitions": [
    {
      "name": "S0C.NEWRUN",
      "body": "'XS' BIND XS 0 GET 1 SUB 1 COLLECT XS -1 DROP CONCAT 'PV' BIND XS PV LT NOT XS PV GT NOT AND NOT",
      "note": "Truth vector: TRUE at each position whose value differs from the previous one (position 0 always TRUE)."
    },
    {
      "name": "S0C.STARTS",
      "body": "'STB' BIND STB LENGTH 'STN' BIND STB 0 STN 1 SUB RANGE GROUP TRUE GET",
      "note": "Indices of the TRUE lanes of a truth vector, ascending (requires a TRUE lane)."
    },
    {
      "name": "S0C.SEGLENS",
      "body": "'BQ' BIND BQ S0C.STARTS 'SQ' BIND SQ BQ LENGTH 1 COLLECT CONCAT 'EQN' BIND EQN 1 DROP EQN -1 DROP SUB",
      "note": "Given a truth vector that starts a segment at each TRUE, the length of each segment."
    },
    {
      "name": "S0C.RLE",
      "body": "'XR' BIND XR S0C.NEWRUN 'NQ' BIND NQ S0C.STARTS 'ST' BIND XR ST GET 'VL' BIND VL NQ S0C.SEGLENS 2 COLLECT ZIP",
      "note": "Run-length encoding: Vector of [ value count ] pairs, one per maximal run."
    },
    {
      "name": "S0C.DEDUPE",
      "body": "'XD' BIND XD S0C.NEWRUN S0C.STARTS 'SD' BIND XD SD GET",
      "note": "Vector with each run of equal adjacent values collapsed to one value."
    },
    {
      "name": "S0C.UPRUNS",
      "body": "'XU' BIND XU 0 GET 1 ADD 1 COLLECT XU -1 DROP CONCAT 'PU' BIND XU PU GT NOT S0C.SEGLENS 0 [ MAX ] FOLD",
      "note": "Length of the longest strictly increasing stretch (a break is every position not greater than its predecessor; segment lengths, then max)."
    },
    {
      "name": "S0C.MAJ",
      "body": "'XM' BIND XM TALLY 'TM' BIND XM LENGTH 'NM' BIND TM KEYS TM VALUES 2 COLLECT ZIP [ 1 GET 2 MUL NM GT ] FILTER FLATTEN 0 GET",
      "note": "Value occurring in more than half the positions (TALLY counts, keep 2*count > length), or NIL."
    },
    {
      "name": "S0C.PRIMES",
      "body": "'NP' BIND 1 NP RANGE 'DV' BIND 2 NP RANGE [ DV DIV RATIO ZIP 1 GET 1 GT NOT [ TRUE AND ] FILTER LENGTH 2 EQ ] FILTER",
      "note": "Primes from 2 to the number: keep m when exactly two of 1..N divide it (den of m/d equals 1)."
    },
    {
      "name": "S0C.DIVISORS",
      "body": "'NX' BIND 1 NX RANGE 'DV' BIND NX DV DIV RATIO ZIP 1 GET 1 GT NOT S0C.STARTS 'SX' BIND DV SX GET",
      "note": "Ascending positive divisors of the number: d in 1..N with N/d an integer."
    },
    {
      "name": "S0C.BINARY",
      "body": "'NB' BIND 0 6 RANGE 'KA' BIND 2 KA POW 'PA' BIND PA NB GT NOT S0C.STARTS 'KV' BIND 2 KV POW 'PK' BIND NB PK DIV FLOOR 'Q' BIND Q Q 2 DIV FLOOR 2 MUL SUB REVERSE STR JOIN",
      "note": "Binary text of N: bits floor(N/2^k) mod 2 for every k with 2^k <= N, most significant first."
    },
    {
      "name": "S0C.CSTEP",
      "body": "'SP' BIND SP 0 GET 'CX' BIND SP 1 GET 'CC' BIND CX 1 EQ 'DN' BIND 1 CX 2 DIV CX 3 MUL 1 ADD CX 2 DIV RATIO 1 GET 1 EQ SELECT DN SELECT 0 1 DN SELECT CC ADD 2 COLLECT",
      "note": "One Collatz step on the pair [ value steps ]; stays at 1 and stops counting once it reaches 1."
