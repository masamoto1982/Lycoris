[ 'XS' BIND XS 0 GET 1 SUB 1 COLLECT XS -1 DROP CONCAT 'PV' BIND XS PV LT NOT XS PV GT NOT AND NOT ] 'S0C.NEWRUN' DEF
[ 'STB' BIND STB LENGTH 'STN' BIND STB 0 STN 1 SUB RANGE GROUP TRUE GET ] 'S0C.STARTS' DEF
[ 'BQ' BIND BQ S0C.STARTS 'SQ' BIND SQ BQ LENGTH 1 COLLECT CONCAT 'EQN' BIND EQN 1 DROP EQN -1 DROP SUB ] 'S0C.SEGLENS' DEF
[ 'XR' BIND XR S0C.NEWRUN 'NQ' BIND NQ S0C.STARTS 'ST' BIND XR ST GET 'VL' BIND VL NQ S0C.SEGLENS 2 COLLECT ZIP ] 'S0C.RLE' DEF
[ 'XD' BIND XD S0C.NEWRUN S0C.STARTS 'SD' BIND XD SD GET ] 'S0C.DEDUPE' DEF
[ 'XU' BIND XU 0 GET 1 ADD 1 COLLECT XU -1 DROP CONCAT 'PU' BIND XU PU GT NOT S0C.SEGLENS 0 [ MAX ] FOLD ] 'S0C.UPRUNS' DEF
[ 'XM' BIND XM TALLY 'TM' BIND XM LENGTH 'NM' BIND TM KEYS TM VALUES 2 COLLECT ZIP [ 1 GET 2 MUL NM GT ] FILTER FLATTEN 0 GET ] 'S0C.MAJ' DEF
[ 'NP' BIND 1 NP RANGE 'DV' BIND 2 NP RANGE [ DV DIV RATIO ZIP 1 GET 1 GT NOT [ TRUE AND ] FILTER LENGTH 2 EQ ] FILTER ] 'S0C.PRIMES' DEF
[ 'NX' BIND 1 NX RANGE 'DV' BIND NX DV DIV RATIO ZIP 1 GET 1 GT NOT S0C.STARTS 'SX' BIND DV SX GET ] 'S0C.DIVISORS' DEF
[ 'NB' BIND 0 6 RANGE 'KA' BIND 2 KA POW 'PA' BIND PA NB GT NOT S0C.STARTS 'KV' BIND 2 KV POW 'PK' BIND NB PK DIV FLOOR 'Q' BIND Q Q 2 DIV FLOOR 2 MUL SUB REVERSE STR JOIN ] 'S0C.BINARY' DEF
[ 'SP' BIND SP 0 GET 'CX' BIND SP 1 GET 'CC' BIND CX 1 EQ 'DN' BIND 1 CX 2 DIV CX 3 MUL 1 ADD CX 2 DIV RATIO 1 GET 1 EQ SELECT DN SELECT 0 1 DN SELECT CC ADD 2 COLLECT ] 'S0C.CSTEP' DEF
[ 'NZ' BIND 0 199 RANGE NZ 0 2 COLLECT [ 0 MUL ADD S0C.CSTEP ] FOLD 1 GET ] 'S0C.COLLATZ' DEF
[ 'FP' BIND FP 1 GET FP 0 GET FP 1 GET ADD 2 COLLECT ] 'S0C.FIBSTEP' DEF
[ 'NF' BIND 0 11 RANGE 0 1 2 COLLECT [ 0 MUL ADD S0C.FIBSTEP ] SCAN [ 0 GET ] MAP 'FL' BIND FL NF LT [ TRUE AND ] FILTER LENGTH 1 ADD ] 'S0C.FIBIDX' DEF
[ STR CHARS [ NUM ] MAP 0 [ ADD ] FOLD ] 'S0C.DSUM' DEF
[ 'CH' BIND '([)]' CH SEARCH ] 'S0C.ENC' DEF
[ 'CE' BIND 'AS' BIND AS -1 DROP AS CE 1 COLLECT CONCAT 2 COLLECT 0 1 CE AS -1 GET SUB 2 EQ SELECT GET ] 'S0C.RSTEP' DEF
[ 'CE' BIND 'AC' BIND AC 1 ADD AC 1 SUB 0 MAX CE 2 LT SELECT ] 'S0C.DEP' DEF
[ CHARS [ S0C.ENC ] MAP ] 'S0C.CODES' DEF
[ S0C.CODES 0 [ S0C.DEP ] SCAN 0 [ MAX ] FOLD ] 'S0C.BRDEPTH' DEF
[ S0C.CODES 9 1 COLLECT [ S0C.RSTEP ] FOLD ] 'S0C.BRSTACK' DEF
[ S0C.BRSTACK LENGTH 1 EQ ] 'S0C.BALANCED' DEF
[ S0C.BRSTACK LENGTH 1 SUB ] 'S0C.UNMATCHED' DEF
[ S0C.CODES 'EV' BIND EV 9 1 COLLECT [ S0C.RSTEP ] SCAN [ LENGTH ] MAP 1 GT NOT 'TB' BIND EV 0 [ 0 MUL ADD 1 ADD ] SCAN 'IX' BIND IX 0 TB SELECT 0 [ MAX ] FOLD ] 'S0C.BALPREFIX' DEF
[ 1 1 2 2 2 3 1 1 ] S0C.RLE
[ 5 ] S0C.RLE
