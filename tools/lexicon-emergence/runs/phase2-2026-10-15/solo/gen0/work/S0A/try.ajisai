[ 0 [ ADD ] FOLD ] 'S0A.SUM' DEF
[ 'V' BIND V S0A.SUM V LENGTH DIV ] 'S0A.MEAN' DEF
[ 'X' BIND X X -1 MUL MAX ] 'S0A.ABS' DEF
[ -1 MUL ORDER 0 GET GET ] 'S0A.ARGMAX' DEF
[ 2 COLLECT ZIP [ 1 GET ] FILTER [ 0 GET ] MAP ] 'S0A.PICK' DEF
[ SORT 'S' BIND S LENGTH 'N' BIND S N 1 SUB 2 DIV FLOOR N 2 DIV FLOOR 2 COLLECT GET S0A.MEAN ] 'S0A.MEDIAN' DEF
[ 'V' BIND V V S0A.MEDIAN SUB S0A.ABS S0A.MEDIAN ] 'S0A.MAD' DEF
[ 'V' BIND V LENGTH 2 SUB 'N' BIND V N TAKE V 1 DROP N TAKE ADD V 2 DROP ADD 3 DIV ] 'S0A.MOVING3' DEF
[ 'V' BIND V V 0 GET [ MAX ] SCAN ] 'S0A.RUNMAX' DEF
[ TALLY 'T' BIND T KEYS T VALUES S0A.ARGMAX ] 'S0A.MOST-FREQ' DEF
[ SORT S0A.MOST-FREQ ] 'S0A.MODE' DEF
[ SORT 1 DROP -1 DROP S0A.MEAN ] 'S0A.TRIMMED' DEF
[ ' ' TOKENIZE ] 'S0A.WORDS' DEF
[ [ ' ' 2 COLLECT ] MAP FLATTEN -1 DROP JOIN ] 'S0A.JOIN-SP' DEF
[ CHARS 'C' BIND C 0 GET UPPER C 1 DROP JOIN 2 COLLECT JOIN ] 'S0A.CAP' DEF
[ S0A.WORDS 'W' BIND W W [ CHARS LENGTH ] MAP S0A.ARGMAX ] 'S0A.LONGEST' DEF
[ ZIP 'Z' BIND Z 0 GET Z 1 GET ] 'S0A.LEDGER-SPLIT' DEF
[ S0A.LEDGER-SPLIT GROUP 'G' BIND G KEYS G VALUES [ S0A.SUM ] MAP RECORD ] 'S0A.BY-NAME' DEF
[ [ 'x' 5 ] [ 'y' 6 ] [ 'x' -1 ] [ 'y' -1 ] [ 'w' 6 ] [ 'v' -1/2 ] ]
'E' BIND E E ZIP 1 GET S0A.ARGMAX
