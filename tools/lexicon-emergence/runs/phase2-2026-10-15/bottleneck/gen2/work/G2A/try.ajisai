[ 'X' BIND X 0 X SUB MAX ] 'G2A.ABS' DEF
[ 'V' BIND V V G0A.MEDIAN SUB G2A.ABS G0A.MEDIAN ] 'G2A.MAD' DEF
[ 'V' BIND V LENGTH 2 SUB 'N' BIND V N TAKE V 1 DROP N TAKE ADD V 2 DROP ADD 3 DIV ] 'G2A.MOVING3' DEF
[ 'V' BIND V V 0 GET [ MAX ] SCAN ] 'G2A.RUNMAX' DEF
[ SORT TALLY G0B.TOPKEY ] 'G2A.MODE' DEF
[ SORT 1 DROP -1 DROP G0A.MEAN ] 'G2A.TRIMMED' DEF
[ 'W' BIND W W [ CHARS LENGTH ] MAP G0A.ARGMAX GET ] 'G2A.LONGEST' DEF
[ CHARS 'C' BIND C 0 GET UPPER C 1 DROP JOIN 2 COLLECT JOIN ] 'G2A.CAP' DEF
[ 'R' BIND R KEYS R VALUES 2 COLLECT ZIP ] 'G2A.PAIRS' DEF
[ G0A.BYNAME G2A.PAIRS [ 1 GET 0 LT ] FILTER [ 0 GET ] MAP ] 'G2A.DEBTORS' DEF
[ [ 'a' 1 ] [ 'b' 3 ] [ 'a' 2 ] [ 'c' 3 ] ]
'L' BIND L L [ 1 GET ] MAP G0A.ARGMAX GET
