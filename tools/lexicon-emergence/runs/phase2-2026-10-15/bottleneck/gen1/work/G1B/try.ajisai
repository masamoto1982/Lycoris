[ 'D' BIND D D -1 MUL MAX ] 'G1B.ABSV' DEF
[ 'V' BIND V G0A.MEDIAN 'M' BIND V M SUB G1B.ABSV G0A.MEDIAN ] 'G1B.MAD' DEF
[ 'V' BIND V LENGTH 2 SUB 'K' BIND V K TAKE V 1 DROP K TAKE ADD V 2 DROP ADD 3 DIV ] 'G1B.MOVING3' DEF
[ 'V' BIND V V 0 GET [ MAX ] SCAN ] 'G1B.RUNMAX' DEF
[ SORT TALLY G0B.TOPKEY ] 'G1B.MODE' DEF
[ SORT 1 DROP -1 DROP G0A.MEAN ] 'G1B.TRIMMED' DEF
[ G0A.WORDS 'W' BIND W W [ CHARS LENGTH ] MAP G0A.ARGMAX GET ] 'G1B.LONGEST' DEF
[ CHARS 'C' BIND C 0 GET UPPER 1 COLLECT C 1 DROP CONCAT JOIN ] 'G1B.CAP' DEF
[ G0A.BYNAME 'R' BIND R KEYS R VALUES 2 COLLECT ZIP [ 1 GET 0 LT ] FILTER [ 0 GET ] MAP ] 'G1B.DEBTORS' DEF
[ 'V' BIND V V ZIP 1 GET G0A.ARGMAX GET ] 'G1B.LARGEST' DEF
[ [ 'a' 1 ] [ 'b' 1 ] [ 'a' 0 ] ]
G1B.LARGEST
