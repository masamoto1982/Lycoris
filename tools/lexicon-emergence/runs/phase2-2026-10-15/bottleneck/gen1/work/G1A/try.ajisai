[ 'X' BIND X 0 X SUB MAX ] 'G1A.ABS' DEF
[ 'V' BIND V V G0A.MEDIAN SUB G1A.ABS G0A.MEDIAN ] 'G1A.MAD' DEF
[ 'V' BIND V -2 DROP V 1 DROP -1 DROP ADD V 2 DROP ADD 3 DIV ] 'G1A.MOVING3' DEF
[ 'V' BIND V V 0 GET [ MAX ] SCAN ] 'G1A.RUNMAX' DEF
[ SORT TALLY G0B.TOPKEY ] 'G1A.MODE' DEF
[ SORT 1 DROP -1 DROP G0A.MEAN ] 'G1A.TRIMMED' DEF
[ 'W' BIND W W [ CHARS LENGTH ] MAP G0A.ARGMAX GET ] 'G1A.LONGEST' DEF
[ CHARS 'C' BIND C 0 GET UPPER C 1 DROP JOIN 2 COLLECT JOIN ] 'G1A.CAPWORD' DEF
[ G0A.WORDS [ G1A.CAPWORD ] MAP G0A.UNWORDS ] 'G1A.CAPITALIZE' DEF
[ G0A.WORDS [ CHARS LENGTH 3 GT ] FILTER [ CHARS 0 GET UPPER ] MAP JOIN ] 'G1A.INITIALS' DEF
[ ZIP 1 GET ] 'G1A.AMOUNTS' DEF
[ ZIP 0 GET ] 'G1A.NAMES' DEF
[ 'R' BIND R KEYS R VALUES 2 COLLECT ZIP [ 1 GET 0 LT ] FILTER [ 0 GET ] MAP ] 'G1A.KEYSWHERE' DEF
[ 'E' BIND E E G1A.AMOUNTS G0A.ARGMAX GET ] 'G1A.LARGEST' DEF
[ [ 'x' -1/2 ] ]
G1A.LARGEST
