[ 0 [ ADD ] FOLD ] 'G0B.SUM' DEF
[ 'V' BIND V G0B.SUM V LENGTH DIV ] 'G0B.MEAN' DEF
[ SORT 'S' BIND S LENGTH 'N' BIND S N 1 SUB 2 DIV FLOOR N 2 DIV FLOOR 2 COLLECT GET G0B.MEAN ] 'G0B.MEDIAN' DEF
[ 'D' BIND D D -1 MUL MAX ] 'G0B.ABS' DEF
[ 'T' BIND T KEYS T VALUES -1 MUL ORDER 0 GET GET ] 'G0B.TOPKEY' DEF
[ [ 'X' BIND ' ' X 2 COLLECT JOIN ] MAP JOIN TRIM ] 'G0B.JOINSP' DEF
[ CHARS 'C' BIND C 0 GET UPPER 1 COLLECT C 1 DROP CONCAT JOIN ] 'G0B.CAP' DEF
[ ZIP 'Z' BIND Z 0 GET Z 1 GET GROUP 'G' BIND G KEYS G VALUES [ G0B.SUM ] MAP RECORD ] 'G0B.BYNAME' DEF
[ [ 'a' -3 ] [ 'b' -1/2 ] ]
'E' BIND E E ZIP 1 GET -1 MUL ORDER 0 GET GET
