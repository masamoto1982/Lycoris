[ 0 [ ADD ] FOLD ] 'G0A.SUM' DEF
[ 'V' BIND V G0A.SUM V LENGTH DIV ] 'G0A.MEAN' DEF
[ 'X' BIND X 0 X SUB MAX ] 'G0A.ABS' DEF
[ 'L' BIND 0 L SUB ORDER 0 GET ] 'G0A.ARGMAX' DEF
[ SORT 'V' BIND V LENGTH 'N' BIND V N 1 SUB 2 DIV FLOOR N 2 DIV FLOOR 2 COLLECT GET G0A.MEAN ] 'G0A.MEDIAN' DEF
[ 'X' BIND X X G0A.MEDIAN SUB G0A.ABS G0A.MEDIAN ] 'G0A.MAD' DEF
[ 'V' BIND V -2 DROP V 1 DROP -1 DROP ADD V 2 DROP ADD 3 DIV ] 'G0A.MOVING3' DEF
[ 'V' BIND V V 0 GET [ MAX ] SCAN ] 'G0A.RUNMAX' DEF
[ SORT TALLY 'T' BIND T KEYS T VALUES G0A.ARGMAX GET ] 'G0A.MODE' DEF
[ SORT 1 DROP -1 DROP G0A.MEAN ] 'G0A.TRIMMED' DEF
[ ' ' TOKENIZE ] 'G0A.WORDS' DEF
[ 'V' BIND V 1 DROP V 0 GET [ 'E' BIND ' ' E 3 COLLECT JOIN ] FOLD ] 'G0A.UNWORDS' DEF
[ CHARS LENGTH ] 'G0A.WLEN' DEF
[ CHARS 'C' BIND C 0 GET UPPER C 1 DROP JOIN 2 COLLECT JOIN ] 'G0A.CAP' DEF
[ ZIP [ 'N' 'A' ] BIND N A GROUP 'G' BIND G KEYS G VALUES [ G0A.SUM ] MAP RECORD ] 'G0A.BYNAME' DEF
[ [ 'ann' 30 ] [ 'bob' -5 ] [ 'ann' 12 ] [ 'cy' -20 ] [ 'bob' 2 ] ]
'E' BIND E E ZIP 1 GET G0A.ARGMAX GET
