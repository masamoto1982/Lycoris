[ 'X' BIND X 0 X SUB MAX ] 'R1A.ABS' DEF
[ 'V' BIND V V X1.FIROSO SUB R1A.ABS X1.FIROSO ] 'R1A.MAD' DEF
[ 'V' BIND V -2 DROP V 1 DROP -1 DROP ADD V 2 DROP ADD 3 DIV ] 'R1A.MOVING3' DEF
[ 'V' BIND V V 0 GET [ MAX ] SCAN ] 'R1A.RUNMAX' DEF
[ SORT TALLY X1.NILUGA ] 'R1A.MODE' DEF
[ SORT 1 DROP -1 DROP X1.GISUZU ] 'R1A.TRIMMED' DEF
[ 'W' BIND W W [ CHARS LENGTH ] MAP X1.PIMAPA GET ] 'R1A.ARGMAX-BY-LEN' DEF
[ CHARS 'C' BIND C 0 GET UPPER C 1 DROP JOIN 2 COLLECT JOIN ] 'R1A.CAPWORD' DEF
[ X1.VIDIKO [ CHARS LENGTH 3 GT ] FILTER [ CHARS 0 GET UPPER ] MAP JOIN ] 'R1A.INITIALS' DEF
[ X1.RIVINO 'R' BIND R KEYS [ 'K' BIND R K GET 0 LT ] FILTER ] 'R1A.DEBTORS' DEF
[ 'E' BIND E E [ 1 GET ] MAP X1.PIMAPA GET ] 'R1A.LARGEST-ENTRY' DEF
[ [ 'x' -1 ] [ 'y' -1 ] ]
R1A.LARGEST-ENTRY
