[ 'V' BIND 0 V LENGTH 1 SUB RANGE [ 'I' BIND I 0 EQ NOT V I GET V I 1 SUB GET SUB 0 EQ AND NOT ] FILTER ] 'S0D.RUNSTARTS' DEF
[ 'X' BIND 1 X RANGE [ 'D' BIND X D DIV RATIO 1 GET 1 EQ ] FILTER ] 'S0D.DIVISORS' DEF
[ S0D.DIVISORS LENGTH 2 EQ ] 'S0D.ISPRIME' DEF
[ 'C' BIND 'A' BIND A CHARS 'AC' BIND '?' 1 COLLECT AC CONCAT -1 GET 'T' BIND '(' '[' C ')' EQ SELECT T EQ 'MATCH' BIND AC AC LENGTH 1 SUB 0 MAX TAKE JOIN A '!' 2 COLLECT JOIN MATCH SELECT 'CLOSED' BIND A C 2 COLLECT JOIN CLOSED '([' C SEARCH NIL? NOT SELECT ] 'S0D.BRSTEP' DEF
[ 'C' BIND 'A' BIND A CHARS 'AC' BIND '?' 1 COLLECT AC CONCAT -1 GET C 2 COLLECT JOIN 'PAIR' BIND AC AC LENGTH 1 SUB 0 MAX TAKE JOIN A C 2 COLLECT JOIN PAIR '()' EQ NOT PAIR '[]' EQ NOT AND NOT SELECT ] 'S0D.CANCEL' DEF
