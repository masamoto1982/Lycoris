[ 'M' BIND 'X' BIND X NIL M SELECT [ NIL? NOT ] FILTER ] 'S0B.KEEP' DEF
[ 'M' BIND 1 0 M SELECT 0 [ ADD ] FOLD ] 'S0B.COUNT' DEF
[ 'V' BIND 0 V LENGTH 1 SUB RANGE 'I' BIND V 0 GET 1 SUB 1 COLLECT V -1 DROP CONCAT 'P' BIND I V P GT NOT V P LT NOT AND NOT S0B.KEEP ] 'S0B.STARTS' DEF
[ 'N' BIND 1 N RANGE 'J' BIND N J DIV 'Q' BIND J Q Q FLOOR SUB 0 GT NOT S0B.KEEP ] 'S0B.DIVISORS' DEF
[ '()' '' REPLACE '[]' '' REPLACE ] 'S0B.PASS' DEF
[ S0B.PASS S0B.PASS S0B.PASS S0B.PASS S0B.PASS S0B.PASS ] 'S0B.REDUCE' DEF
'([]())'
S0B.REDUCE CHARS LENGTH
