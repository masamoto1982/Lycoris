# S0C definitions
[ 'S0C.RV' BIND S0C.RV LENGTH 'S0C.RN' BIND S0C.RV -1 DROP 'S0C.RP' BIND S0C.RV 1 DROP 'S0C.RC' BIND S0C.RP S0C.RC LT NOT S0C.RP S0C.RC GT NOT AND NOT 'S0C.RF' BIND 0 S0C.RN 1 SUB RANGE 1 DROP 'S0C.RI' BIND S0C.RF S0C.RI 2 COLLECT ZIP [ 0 GET ] FILTER [ 1 GET ] MAP 'S0C.RJ' BIND [ 0 ] S0C.RJ CONCAT ] 'S0C.STARTS' DEF
[ 'S0C.RV' BIND S0C.RV S0C.STARTS 'S0C.RS' BIND S0C.RV LENGTH 'S0C.RN' BIND S0C.RV S0C.RS GET S0C.RS 1 DROP S0C.RN 1 COLLECT CONCAT S0C.RS SUB 2 COLLECT ZIP ] 'S0C.RLE' DEF
[ 'S0C.DK' BIND 1 S0C.DK RANGE 'S0C.DD' BIND S0C.DK S0C.DD DIV 'S0C.DQ' BIND S0C.DQ S0C.DQ FLOOR SUB 0 GT NOT S0C.DD 2 COLLECT ZIP [ 0 GET ] FILTER [ 1 GET ] MAP ] 'S0C.DIVS' DEF
[ 'S0C.NW' BIND S0C.NW 2 DIV S0C.NW 3 MUL 1 ADD S0C.NW S0C.NW 2 DIV FLOOR 2 MUL SUB 0 EQ SELECT ] 'S0C.NEXT' DEF
[ 'S0C.CA' BIND S0C.CA 0 GET 'S0C.CV' BIND S0C.CA 1 GET 'S0C.CS' BIND S0C.CV S0C.CV S0C.NEXT S0C.CV 1 EQ SELECT S0C.CS S0C.CS 1 ADD S0C.CV 1 EQ SELECT 2 COLLECT ] 'S0C.CSTEP' DEF
[ 'S0C.BX' BIND 'S0C.BST' BIND S0C.BX 2 GT S0C.BX 2 SUB S0C.BST 0 GET S0C.BST 0 GET 5 DIV FLOOR 5 MUL SUB EQ AND 'S0C.BP' BIND S0C.BST 0 GET 5 DIV FLOOR S0C.BST 0 GET 5 MUL S0C.BX ADD S0C.BP SELECT S0C.BST 1 GET 1 SUB S0C.BST 1 GET 1 ADD S0C.BP SELECT 2 COLLECT ] 'S0C.BSTEP' DEF
[ '(' '1' REPLACE '[' '2' REPLACE ')' '3' REPLACE ']' '4' REPLACE CHARS NUM ] 'S0C.BRKCODES' DEF
[ 'S0C.RC' BIND S0C.RC 0 0 2 COLLECT [ S0C.BSTEP ] FOLD ] 'S0C.REDUCE' DEF
60
'S0C.CN' BIND 0 199 RANGE S0C.CN 0 2 COLLECT [ 0 MUL ADD S0C.CSTEP ] FOLD 1 GET
