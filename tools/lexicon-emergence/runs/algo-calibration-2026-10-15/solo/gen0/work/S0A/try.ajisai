[ 'V' BIND 0 V LENGTH 1 SUB RANGE [ 'I' BIND I 0 EQ NOT V I GET V I 1 SUB GET EQ AND NOT ] FILTER ] 'S0A.RUNSTARTS' DEF
[ 'V' BIND V V S0A.RUNSTARTS GET ] 'S0A.DEDUPE' DEF
[ 'V' BIND V S0A.RUNSTARTS 'S' BIND S 1 DROP V LENGTH 1 COLLECT CONCAT S SUB 'C' BIND V S GET C 2 COLLECT ZIP ] 'S0A.RLE' DEF
[ 'V' BIND 0 V LENGTH 1 SUB RANGE 0 [ 'I' BIND 'A' BIND A 1 ADD 1 I 0 GT V I GET V I 1 SUB GET GT AND SELECT ] SCAN 0 [ MAX ] FOLD ] 'S0A.UPRUNS' DEF
[ UNIQUE SORT 'U' BIND U -2 GET 'X' BIND NIL X U LENGTH 2 LT SELECT ] 'S0A.SECOND-LARGEST' DEF
[ 'V' BIND V TALLY 'T' BIND T KEYS 'K' BIND T VALUES 'C' BIND K 0 K LENGTH 1 SUB RANGE [ 'I' BIND C I GET 2 MUL V LENGTH GT ] FILTER GET 'M' BIND M 0 GET 'X' BIND NIL X M LENGTH 0 EQ SELECT ] 'S0A.MAJORITY' DEF
[ 'N' BIND 1 N RANGE [ 'D' BIND N D DIV 'Q' BIND Q Q FLOOR EQ ] FILTER ] 'S0A.DIVISORS' DEF
[ S0A.DIVISORS LENGTH 2 EQ ] 'S0A.PRIME?' DEF
[ 'N' BIND 1 N RANGE [ S0A.PRIME? ] FILTER ] 'S0A.PRIMES' DEF
[ 'N' BIND N 2 N 0 RANGE POW DIV FLOOR 'Q' BIND Q Q 2 DIV FLOOR 2 MUL SUB 'B' BIND 0 N RANGE [ 'I' BIND Q I GET 0 GT ] FILTER 'K' BIND B K GET STR JOIN ] 'S0A.BINARY' DEF
[ 'X' BIND X 2 DIV 'H' BIND 1 H X 3 MUL 1 ADD H FLOOR H EQ SELECT X 1 EQ SELECT ] 'S0A.COLLATZ-STEP' DEF
[ 'N' BIND 1 250 RANGE N [ 'I' BIND S0A.COLLATZ-STEP ] SCAN N 1 COLLECT CONCAT [ 1 GT ] FILTER LENGTH ] 'S0A.COLLATZ' DEF
[ 1 SUB 'M' BIND M M 9 DIV FLOOR 9 MUL SUB 1 ADD ] 'S0A.DIGITAL-ROOT' DEF
[ 'N' BIND 1 N 2 ADD RANGE [ 0 1 ] [ 'I' BIND [ 'A' 'B' ] BIND B A B ADD 2 COLLECT ] SCAN [ 0 GET ] MAP [ N LT ] FILTER LENGTH 1 ADD ] 'S0A.FIB-INDEX' DEF
[ 'C' BIND 'S' BIND S C 2 COLLECT JOIN '()' '' REPLACE '[]' '' REPLACE ] 'S0A.BRACKET-STEP' DEF
[ CHARS '' [ S0A.BRACKET-STEP ] FOLD ] 'S0A.BRACKET-REDUCE' DEF
[ CHARS '' [ S0A.BRACKET-STEP ] SCAN ] 'S0A.BRACKET-REDUCTIONS' DEF
[ S0A.BRACKET-REDUCE '' EQ ] 'S0A.BALANCED?' DEF
[ S0A.BRACKET-REDUCE CHARS LENGTH ] 'S0A.UNMATCHED' DEF
[ S0A.BRACKET-REDUCTIONS 'R' BIND '' 1 COLLECT R CONCAT 'P' BIND 0 P LENGTH 1 SUB RANGE [ 'L' BIND P L GET '' EQ ] FILTER 0 [ MAX ] FOLD ] 'S0A.BALANCED-PREFIX' DEF
[ CHARS [ 'C' BIND 1 -1 C '(' EQ NOT C '[' EQ NOT AND NOT SELECT ] MAP 0 [ ADD 0 MAX ] SCAN 0 [ MAX ] FOLD ] 'S0A.BRACKET-DEPTH' DEF
[ 1 1 2 2 2 3 1 1 ]
S0A.UPRUNS
